{
  "name": "mbc/rest-api",
  "description": "MBC REST API Backend",
  "type": "project",
  "require": {
    "php": "^8.0",
    "firebase/php-jwt": "^6.10",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.5",
    "symfony/rate-limiter": "^7.0",
    "respect/validation": "^2.3"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "Mbc\\Api\\": "src/",
      "Mbc\\Api\\Request\\": "request/",
      "Mbc\\Api\\Auth\\": "auth/",
      "Mbc\\Api\\Lib\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mbc\\Api\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse src request auth lib --level=5"
  }
}
