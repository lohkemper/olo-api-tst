# ============================================================================
# CORS Headers - Production Quick Fix
# ============================================================================
# Diese Datei kann direkt auf den Server hochgeladen werden als .htaccess
# ============================================================================

<IfModule mod_headers.c>
  # Allow specific origins
  SetEnvIf Origin "^http(s)?://(localhost:4200|oliverlohkemper\.de|www\.oliverlohkemper\.de)$" AccessControlAllowOrigin=$0

  # Set CORS headers if origin is allowed
  Header always set Access-Control-Allow-Origin "%{AccessControlAllowOrigin}e" env=AccessControlAllowOrigin
  Header always set Access-Control-Allow-Credentials "true" env=AccessControlAllowOrigin
  Header always set Access-Control-Max-Age "86400" env=AccessControlAllowOrigin

  # Allow all necessary methods and headers
  Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-CSRF-Token, X-Requested-With, Accept"
</IfModule>

# ============================================================================
# HTTPS Detection + Enforcement (STORY-2.5 TASK-2.5.1)
# ============================================================================
# Ionos terminiert SSL am Reverse-Proxy, daher liefert %{HTTPS} nicht immer
# "on". Wir setzen die Env-Variable HTTPS_ACTIVE via mod_rewrite [E=...],
# damit Header-Direktiven verlaesslich darauf zugreifen koennen.
# HTTP-Requests werden per 301 auf HTTPS umgeleitet (ausser localhost).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Mark request as HTTPS (direct or via reverse proxy)
  RewriteCond %{HTTPS} =on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =https
  RewriteRule ^ - [E=HTTPS_ACTIVE:1]

  # Force HTTPS redirect (skip localhost for local dev)
  RewriteCond %{ENV:HTTPS_ACTIVE} !=1
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ============================================================================
# Handle OPTIONS Preflight Request
# ============================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /rest2/

  # Handle OPTIONS preflight - return 200 OK immediately
  RewriteCond %{REQUEST_METHOD} OPTIONS
  RewriteRule ^(.*)$ $1 [R=200,L]

  # Handle all paths that are not real files or directories
  # This catches: auth/login, users/123/roles, roles, permissions, etc.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)$ /rest2/index.php?r=$1 [QSA,L]
</IfModule>

# ============================================================================
# Security Headers — Spec docs/design/security.md
# ============================================================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"

  # Spec verlangt DENY (API-Responses sollten niemals in iframes landen).
  # Wechsel von SAMEORIGIN (2026-05-14) — restriktiver, da REST-API nur JSON
  # ausliefert und keinerlei iframe-Einbettung sinnvoll wäre.
  Header always set X-Frame-Options "DENY"

  Header always set X-XSS-Protection "1; mode=block"

  # Referrer-Policy — keine Referer zu Drittparteien
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions-Policy — deaktiviert sensitive Browser-APIs für die API-Domain
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # Content-Security-Policy für API-Responses (JSON-only, sehr restriktiv).
  # Die App-CSP wird im App-Apache-Container gesetzt (siehe app.htaccess.example).
  Header always set Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"

  # HSTS - only on HTTPS responses (RFC 6797: MUST NOT send over plain HTTP)
  # expr= wird zur Response-Zeit ausgewertet und ueberlebt interne Rewrites.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"
</IfModule>
