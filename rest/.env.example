# Datenbank-Konfiguration
DB_DSN=mysql:dbname=your_database;host=your_host;port=3306;charset=utf8mb4
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_PREFIX=mbc

# JWT-Konfiguration
JWT_SECRET=your-very-long-and-secure-random-secret-key-change-this-in-production

# Debug-Modus (true für Entwicklung, false für Produktion)
DEBUG=false

# Logging-Level (debug, info, warning, error, critical)
LOG_LEVEL=info

# IMAP-Konfiguration (für Email-Modul - Phase 1)
# ============================================
# Unterstützte Provider:
# - Gmail: imap.gmail.com, Port: 993, Encryption: ssl
#   (Benötigt App-spezifisches Passwort: https://myaccount.google.com/apppasswords)
# - Outlook/Office365: outlook.office365.com, Port: 993, Encryption: ssl
# - Yahoo: imap.mail.yahoo.com, Port: 993, Encryption: ssl
# - Custom IMAP: Siehe Provider-Dokumentation

IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=your-email@example.com
IMAP_PASSWORD=your-app-specific-password
IMAP_ENCRYPTION=ssl

# SMTP-Konfiguration (MFA-E-Mail-Codes, später Passwort-Reset)
# ============================================
# GMX:     SMTP_HOST=mail.gmx.net, Port 587, tls (App-Passwort nötig:
#          GMX → Einstellungen → Sicherheit → Anwendungsspezifische Passwörter)
# Hosting: SMTP-Zugangsdaten des Webhosting-Postfachs (oliverlohkemper.de)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-specific-password
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=MBC

# MFA/2FA (Plan: docs/planning/mfa-2fa.md)
# ============================================
# Verschlüsselung der TOTP-Secrets at rest. Erzeugen mit:
#   php -r "echo base64_encode(random_bytes(32));"
APP_ENCRYPTION_KEY=base64-of-32-random-bytes
# WebAuthn/Passkeys: RP-ID = registrierbare Domain der App (OHNE Schema/Pfad).
# Passkey-Ceremonies funktionieren nur auf Origins unterhalb der RP-ID —
# das Dev-FE auf localhost:4202 kann Passkeys gegen die Prod-RP-ID NICHT nutzen.
WEBAUTHN_RP_ID=oliverlohkemper.de
WEBAUTHN_RP_NAME=MBC
WEBAUTHN_ALLOWED_ORIGINS=https://oliverlohkemper.de

# Google-Kalender-OAuth (für Grow-Modul - Dünge-Erinnerungen)
# ============================================
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Typ: Web application).
# Google Calendar API muss aktiviert sein. Scope: .../auth/calendar.events.
# Autorisierte Redirect-URI in der Cloud Console MUSS exakt GOOGLE_OAUTH_REDIRECT_URI entsprechen.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://oliverlohkemper.de/rest2/grow/gcal-callback
GOOGLE_OAUTH_SPA_RETURN_URL=https://oliverlohkemper.de/mbc/grow/settings

# Social-Login (Google + Facebook) — Anmelden/Registrieren über Provider
# ============================================
# Setup-Anleitung: docs/setup/social-login.md
# Google: derselbe Cloud-Console-Client wie GOOGLE_OAUTH_* darf wiederverwendet
# werden — dann nur die zweite Redirect-URI im Client eintragen.
GOOGLE_LOGIN_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_LOGIN_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_LOGIN_REDIRECT_URI=https://oliverlohkemper.de/rest2/auth/google-callback
# Facebook: developers.facebook.com → Consumer-App → Produkt "Facebook Login".
FACEBOOK_LOGIN_APP_ID=your-facebook-app-id
FACEBOOK_LOGIN_APP_SECRET=your-facebook-app-secret
FACEBOOK_LOGIN_REDIRECT_URI=https://oliverlohkemper.de/rest2/auth/facebook-callback
FACEBOOK_GRAPH_VERSION=v23.0
# Rücksprung in die SPA nach dem Callback. Dev-Origins (Whitelist, Komma-Liste)
# werden beim /auth/social-url-Aufruf per Origin-Header erkannt.
SOCIAL_LOGIN_SPA_RETURN_URL=https://oliverlohkemper.de/mbc
SOCIAL_LOGIN_ALLOWED_DEV_ORIGINS=http://localhost:4200,http://localhost:4202
